# ============================================================
# .env.example  —  실제 .env 파일 작성 시 이 파일을 복사하세요
#   cp .env.example .env
#   (실제 .env는 .gitignore에 의해 커밋되지 않습니다)
# ============================================================

# ── DB 접속 ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=news_collector
DB_USER=news
DB_PASSWORD=changeme

# ── 텔레그램 ──────────────────────────────────────────────────
# BotFather에서 발급받은 토큰과 채팅 ID를 입력하세요
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 로그 ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs

# ── 브리핑 ────────────────────────────────────────────────────
BRIEFING_HOURS_BACK=12
BRIEFING_OUTPUT_DIR=output
