# 가상환경 — 이미지 내에서 새로 설치
.venv/
venv/

# 시크릿 — 절대 이미지에 포함하면 안 됨
.env
.env.*

# 로그 / 출력 — docker-compose 볼륨 마운트로 처리
logs/
output/

# 테스트
tests/
.pytest_cache/
.coverage
htmlcov/

# Python 캐시
__pycache__/
*.pyc
*.pyo

# IDE / 에디터
.vscode/
.idea/
.claude/

# Git
.git/
.gitignore

# 문서 (이미지 크기 절감)
docs/
*.md
*.example

# 호스트 전용 운영 파일 (이미지에 불필요)
systemd/
job.sh
crontab.example

# docker/ 폴더는 이미지에 포함하지 않아도 됨
# (initdb SQL은 compose 볼륨 마운트로만 사용)
docker/
